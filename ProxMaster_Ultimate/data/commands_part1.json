  "commands": [
    {"id": "hf_search", "category": "hf_search", "name": "Поиск всех HF карт", "description": "Поиск всех типов карт в поле антенны на высокой частоте (13.56 MHz)", "template": "hf search", "risk_level": "safe", "timeout": 15000, "parameters": [], "examples": ["hf search"], "tips": ["Убедитесь, что карта находится близко к антенне", "Может занять до 15 секунд"]},
    {"id": "hf_search_verbose", "category": "hf_search", "name": "Поиск HF с подробным выводом", "description": "Поиск HF карт с детальным выводом информации о каждой найденной карте", "template": "hf search -v", "risk_level": "safe", "timeout": 20000, "parameters": [], "examples": ["hf search -v"], "tips": ["Используйте для получения полной информации о карте"]},
    {"id": "hf_list", "category": "hf_search", "name": "Список последних HF операций", "description": "Отображение списка последних операций с HF картами", "template": "hf list", "risk_level": "safe", "timeout": 5000, "parameters": [], "examples": ["hf list"], "tips": ["Полезно для отладки"]},
    {"id": "hf_reader_select", "category": "hf_search", "name": "Выбор карты читателем", "description": "Выбор карты с использованием стандартного протокола выбора", "template": "hf reader select", "risk_level": "safe", "timeout": 10000, "parameters": [], "examples": ["hf reader select"], "tips": ["Стандартная процедура выбора карты ISO14443"]},
    {"id": "hf_scan", "category": "hf_search", "name": "Сканирование HF поля", "description": "Сканирование HF поля для обнаружения карт", "template": "hf scan", "risk_level": "safe", "timeout": 10000, "parameters": [], "examples": ["hf scan"], "tips": ["Быстрое сканирование наличия карт"]},
    {"id": "hf_info", "category": "hf_search", "name": "Информация о выбранной карте", "description": "Получение подробной информации о выбранной карте", "template": "hf info", "risk_level": "safe", "timeout": 10000, "parameters": [], "examples": ["hf info"], "tips": ["Показывает все доступные данные о карте"]},
    {"id": "hf_turntable", "category": "hf_search", "name": "Поворотная таблица HF", "description": "Автоматическое определение типа HF карты через перебор протоколов", "template": "hf turntable", "risk_level": "safe", "timeout": 30000, "parameters": [], "examples": ["hf turntable"], "tips": ["Последовательно пробует все протоколы"]},
    {"id": "hf_trace", "category": "hf_search", "name": "Трассировка HF", "description": "Запись трассировки обмена данными с HF картой", "template": "hf trace", "risk_level": "safe", "timeout": 60000, "parameters": [], "examples": ["hf trace"], "tips": ["Сохраняет полную трассировку в буфер"]},
    {"id": "hf_clear_trace", "category": "hf_search", "name": "Очистка трассировки", "description": "Очистка буфера трассировки HF", "template": "hf trace clear", "risk_level": "safe", "timeout": 2000, "parameters": [], "examples": ["hf trace clear"], "tips": ["Очищает буфер перед новой записью"]},
    {"id": "hf_get_trace", "category": "hf_search", "name": "Получение трассировки", "description": "Получение сохраненной трассировки HF обмена", "template": "hf trace get", "risk_level": "safe", "timeout": 10000, "parameters": [], "examples": ["hf trace get"], "tips": ["Выводит сохраненную трассировку"]},
