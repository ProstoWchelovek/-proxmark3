    {"id": "hf_load_trace", "category": "hf_search", "name": "Загрузка трассировки", "description": "Загрузка трассировки HF из файла", "template": "hf trace load <filename>", "risk_level": "safe", "timeout": 5000, "parameters": [{"name": "filename", "type": "string", "required": true, "description": "Имя файла для загрузки"}], "examples": ["hf trace load trace1.bin"], "tips": ["Загружает ранее сохраненную трассировку"]},
