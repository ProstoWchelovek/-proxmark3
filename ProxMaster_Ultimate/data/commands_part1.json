    {"id": "hf_analyzer", "category": "hf_search", "name": "Анализ HF сигнала", "description": "Анализ качества и параметров HF сигнала", "template": "hf analyzer", "risk_level": "safe", "timeout": 15000, "parameters": [], "examples": ["hf analyzer"], "tips": ["Показывает амплитуду, частоту, модуляцию"]},
