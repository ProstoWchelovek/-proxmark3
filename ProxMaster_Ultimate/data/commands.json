        {
            "id": "hf_write_t55x7",
            "category": "write",
            "name": "Запись T55x7",
            "description": "Запись данных в карту T55x7",
            "command_template": "hf t55xx write {page} {data}",
            "risk_level": "dangerous",
            "timeout": 20,
            "icon": "write_card",
            "parameters": [
                {
                    "name": "page",
                    "type": "integer",
                    "description": "Номер страницы для записи",
                    "default": 0,
                    "min": 0,
                    "max": 7,
                    "required": true
                },
                {
                    "name": "data",
                    "type": "hex_string",
                    "description": "Данные для записи в hex формате",
                    "pattern": "^[0-9A-Fa-f]+$",
                    "required": true
                }
            ],
            "output_format": "write_result",
            "help_text": "Записывает данные в указанную страницу карты T55x7. Внимание: операция необратима!"
        },
        {
            "id": "lf_write_t55x7",
            "category": "write",
            "name": "Запись LF T55x7",
            "description": "Запись данных в LF карту T55x7",
            "command_template": "lf t55xx write {block} {data}",
            "risk_level": "dangerous",
            "timeout": 20,
            "icon": "write_card",
            "parameters": [
                {
                    "name": "block",
                    "type": "integer",
                    "description": "Номер блока для записи",
                    "default": 0,
                    "min": 0,
                    "max": 7,
                    "required": true
                },
                {
                    "name": "data",
                    "type": "hex_string",
                    "description": "Данные для записи в hex формате",
                    "pattern": "^[0-9A-Fa-f]{8}$",
                    "required": true
