{
    "app_info": {
        "name": "ProxMaster Ultimate",
        "version": "1.0.0",
        "author": "ProxMaster Team",
        "description": "Полноценное GUI приложение для управления Proxmark3 Easy/Iceman",
        "min_python_version": "3.8",
        "supported_devices": ["Proxmark3 Easy", "Proxmark3 Iceman", "Proxmark3 RDV4"]
    },
    "device_settings": {
        "default_connection_type": "usb",
        "connection_types": ["usb", "bluetooth", "wifi"],
        "timeout_seconds": 30,
        "retry_attempts": 3,
        "baud_rate": 115200,
        "auto_reconnect": true,
        "heartbeat_interval": 5
    },
    "interface_settings": {
        "language": "ru",
        "theme": "dark",
        "font_size": 12,
        "log_max_lines": 10000,
        "auto_scroll_log": true,
        "show_tooltips": true,
        "confirm_dangerous_operations": true
    },
    "update_settings": {
        "check_updates_on_start": true,
        "auto_download_updates": false,
        "update_channels": ["stable", "beta", "dev"],
        "current_channel": "stable"
    }
}
