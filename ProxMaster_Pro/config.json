{
  "app_info": {
    "name": "ProxMaster Professional",
    "version": "1.0.0",
    "author": "ProxMaster Team",
    "description": "Профессиональный инструмент для управления Proxmark3 Easy/Iceman",
    "min_proxmark_firmware": "4.0",
    "supported_devices": ["Proxmark3 Easy", "Proxmark3 Iceman", "Proxmark3 RDV4"]
  },
  "settings": {
    "default_port": "COM3",
    "default_baudrate": 115200,
    "timeout_seconds": 30,
    "max_log_lines": 10000,
    "auto_save_logs": true,
    "theme": "dark",
    "language": "ru",
    "check_updates_on_start": true,
    "confirm_dangerous_operations": true
  },
  "ui": {
    "main_window_width": 1400,
    "main_window_height": 900,
    "log_panel_height": 200,
    "hex_editor_font_size": 11,
    "node_editor_grid_size": 20,
    "colors": {
      "log_info": "#ffffff",
      "log_success": "#00ff00",
      "log_warning": "#ffff00",
      "log_error": "#ff0000",
      "log_debug": "#888888",
      "node_input": "#4a90d9",
      "node_output": "#50c878",
      "node_process": "#ffa500",
      "node_command": "#9370db"
    }
  },
  "paths": {
    "dumps": "data/dumps",
    "keys": "data/keys",
    "nodes": "data/nodes",
    "logs": "logs",
    "assets": "assets"
  },
  "features": {
    "enable_hex_editor": true,
    "enable_node_editor": true,
    "enable_signal_visualization": true,
    "enable_drag_drop": true,
    "enable_auto_update": true,
    "enable_scripting": true,
    "enable_batch_operations": true
  }
}
